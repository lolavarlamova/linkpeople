# LinkPeople — environment variables (server-side only).
# Copy names into Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env. The Resend API key must NOT be a public/NEXT_PUBLIC_ variable.

# Required for the contact + talent forms to actually send email:
RESEND_API_KEY=

# Sending identity (must be on a Resend-verified domain):
FORM_FROM_EMAIL=LinkPeople Website <website@linkpeople.agency>

# Internal recipients (safe defaults are also hardcoded server-side):
EMPLOYER_INBOX=hello@linkpeople.agency
TALENT_INBOX=talent@linkpeople.agency

# Public site URL (informational):
SITE_URL=https://www.linkpeople.agency
